# ─────────────────────────────────────────────────────────────
# AI provider — Gemini is PRIMARY. The app picks a provider by
# whichever key is present, in this order:
#   1. GEMINI_API_KEY     (primary)
#   2. ANTHROPIC_API_KEY  (fallback)
#   3. none               → deterministic demo mode (no API calls)
# ─────────────────────────────────────────────────────────────

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional fallback provider — Anthropic Claude
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────
# Accounts & database — PostgreSQL (Neon). Enables accounts and
# cross-device history sync. Without them the app still runs and
# stores history in the browser's localStorage.
# ─────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer) — used by the app at runtime.
# Neon: copy the "Pooled connection" string (host contains -pooler).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection — used by Prisma for migrations only.
# Same string with `-pooler` removed from the host.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret — generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
