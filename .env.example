# ─────────────────────────────────────────────────────────────
# AI provider — Gemini is PRIMARY. The app picks a provider by
# whichever key is present, in this order:
#   1. GEMINI_API_KEY     (primary)
#   2. ANTHROPIC_API_KEY  (fallback)
#   3. none               → deterministic demo mode (no API calls)
# ─────────────────────────────────────────────────────────────

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback provider — Anthropic Claude
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────
# Accounts & database (optional — the app works without them,
# falling back to browser localStorage). Enables cross-device
# history sync on web and mobile.
# ─────────────────────────────────────────────────────────────

# Database connection.
#   LOCAL DEV (SQLite, zero setup):  file:./dev.db
#   PRODUCTION (cross-device sync):  a Neon/Supabase Postgres URL,
#     e.g. postgresql://user:pass@host/db?sslmode=require
#     (also switch `provider` to "postgresql" in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
